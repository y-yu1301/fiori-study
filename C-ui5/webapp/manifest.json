{
  "_version": "1.85.0",
  "sap.app": {
    "id": "c.filter.edit.ui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/CampaignService/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.149.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "c.filter.edit.ui.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "ja"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": []
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "c.filter.edit.ui.ext.controller.ListReportExt"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "c.filter.edit.ui.ext.controller.ObjectPageExt"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CampaignsList",
          "target": "CampaignsList"
        },
        {
          "pattern": "Campaigns({key}):?query:",
          "name": "CampaignsObjectPage",
          "target": "CampaignsObjectPage"
        }
      ],
      "targets": {
        "CampaignsList": {
          "type": "Component",
          "id": "CampaignsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Campaigns",
              "variantManagement": "Page",
              "navigation": {
                "Campaigns": {
                  "detail": {
                    "route": "CampaignsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "beforeRebindTable": ".extension.c.filter.edit.ui.ext.controller.ListReportExt.onBeforeRebindCampaigns"
                  }
                }
              }
            }
          }
        },
        "CampaignsObjectPage": {
          "type": "Component",
          "id": "CampaignsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Campaigns",
              "editableHeaderContent": false,
              "controlConfiguration": {
                "bulkEditItems/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "enableFullScreen": true,
                    "beforeRebindTable": ".extension.c.filter.edit.ui.ext.controller.ObjectPageExt.onBeforeRebindEditableRows"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
