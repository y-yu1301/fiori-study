// =============================================================================
// アプリD : 一括編集サンプル ― データモデル
// -----------------------------------------------------------------------------
// 【このアプリが解こうとしている課題】
//   Fiori Elements の標準は「List Report で1件選ぶ → Object Page で1件編集」。
//   絞り込み結果の 37 件をまとめて直したいとき、37 回往復することになります。
//
// 【アプリDの解き方 ＝ 編集セッション（作業セット）方式】
//   「編集したい集合」を表す“代表レコード1件”＝ BulkEditSessions を先に作り、
//   その明細 BulkEditItems に対象行のコピーを詰め込みます。
//   すると Object Page は「キー1件を表示する画面」という標準の作りのまま、
//   中身は絞り込み結果の全件、という状態になります。
//
//   ┌─────────────┐   prepareBulkEdit    ┌──────────────────┐
//   │PurchaseRequests│ ──(条件で検索)──▶ │BulkEditSessions  │ ← Object Page はこの1件を開く
//   │  （元データ）  │      コピー        │  └ BulkEditItems │ ← 明細テーブルで行ごとに編集
//   └─────────────┘                      └──────────────────┘
//                  ◀────── applyBulkEdit（書き戻し）──────┘
//
// 【重要な設計判断】
//   ・明細は元レコードへの Association ではなく「値のコピー」。
//     元データが独自の Draft を持っていても衝突しないようにするためです。
//   ・親子は Composition。親に @odata.draft.enabled を付けることで、
//     「明細のインライン編集 → 1回の保存でまとめて確定」が Draft の標準機能で実現します。
//   ・絞り込み条件はセッション作成時の1回だけサーバへ渡します。
//     以降のリクエストでは一切運びません（＝画面遷移のたびに条件を持ち回らない）。
// =============================================================================
namespace sample.procurement;

using { cuid, managed } from '@sap/cds/common';

// -----------------------------------------------------------------------------
// 元データ：購買申請
// -----------------------------------------------------------------------------
// List Report で絞り込む対象であり、最終的に「反映」で更新される先でもあります。
// cuid   … ID : UUID (key) を生やす
// managed… createdAt / createdBy / modifiedAt / modifiedBy を生やし、CAP が自動更新する
//          この modifiedAt を後述の楽観ロック（競合検知）に使います。
// -----------------------------------------------------------------------------
entity PurchaseRequests : cuid, managed {
  requestNo    : String(20);   // 申請番号（人が読む業務キー。例：PR-2026-0001）
  title        : String(100);  // 件名
  department   : String(40);   // 部門（絞り込み用）
  status       : String(20);   // DRAFT / SUBMITTED / APPROVED / REJECTED
  requestDate  : Date;         // 申請日（範囲絞り込み用）
  quantity     : Integer;      // 数量   ← 一括編集の対象
  unitPrice    : Decimal(15,2);// 単価   ← 一括編集の対象
  remark       : String(200);  // 備考   ← 一括編集の対象
}

// -----------------------------------------------------------------------------
// 編集セッション（＝作業セットのヘッダー。Object Page が開く“代表1件”）
// -----------------------------------------------------------------------------
// managed の createdBy が「セッションの所有者」になります。
// 他人のセッションを覗けないよう、サービス側で createdBy = $user の制限を掛けます。
// -----------------------------------------------------------------------------
entity BulkEditSessions : cuid, managed {
  description   : String(100);   // 例：「絞り込み結果 37件（2026-08-12 14:03）」
  itemCount     : Integer;       // 明細件数（画面ヘッダー表示用）

  // 監査・再現用。どんな条件で作られたセッションかを JSON のまま保存します。
  // 「読み取り専用の記録」であり、この値を後続処理で読み直して再検索することはしません。
  criteria      : LargeString;

  appliedAt     : Timestamp;     // 反映済みなら日時が入る（null＝未反映）

  // Composition ＝「親が消えれば子も消える」強い所有関係。
  // これにより Fiori Elements 側で「明細のインライン編集＋親の保存でまとめて確定」
  // が Draft の標準機能として成立します（Association だとこうはなりません）。
  items         : Composition of many BulkEditItems on items.parent = $self;
}

// -----------------------------------------------------------------------------
// 編集セッション明細（＝絞り込み結果1行のコピー）
// -----------------------------------------------------------------------------
entity BulkEditItems : cuid {
  parent           : Association to BulkEditSessions;

  // --- 元レコードの識別と競合検知 -------------------------------------------
  sourceID         : UUID;      // 書き戻し先 PurchaseRequests.ID
  // セッション作成時点の元レコードの modifiedAt。
  // 反映時にこれと現在値を突き合わせ、違っていれば「誰かが先に更新した」＝CONFLICT。
  // （＝楽観ロック。ロックを取らずに衝突だけを検知する方式）
  sourceModifiedAt : Timestamp;

  // --- 表示専用（コピー）-----------------------------------------------------
  // どの申請の行なのかを画面で判別するための情報。編集はできません。
  requestNo        : String(20);
  title            : String(100);
  department       : String(40);
  status           : String(20);

  // --- 編集対象 ---------------------------------------------------------------
  // Object Page の明細テーブルで行ごとに違う値を入力するのはこの3つです。
  quantity         : Integer;
  unitPrice        : Decimal(15,2);
  remark           : String(200);

  // --- 反映結果 ---------------------------------------------------------------
  // 部分成功を許容する設計なので、行ごとに結果が残ります。
  // PENDING（未反映）/ APPLIED（反映済）/ CONFLICT（競合）/ ERROR（業務チェック違反）
  applyStatus      : String(20);
  applyMessage     : String(200);

  // 画面の色付け用（UI.Criticality）。0=中立 1=赤 2=黄 3=緑。
  // 「文字列 applyStatus を見て色を決める」ロジックを画面に書かずに済むよう、
  // サーバ側で数値に翻訳して持たせています（＝表示ロジックのサーバ集約）。
  applyCriticality : Integer;
}
