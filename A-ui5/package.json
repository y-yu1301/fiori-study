{
  "name": "project1",
  "version": "0.0.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.33",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
    "eslint": "^10",
    "typescript": "^5.9.2",
    "ui5-tooling-transpile": "^3.12.0"
  },
  "ui5": {
    "dependencies": [
      "ui5-tooling-transpile"
    ]
  },
  "scripts": {
    "//start": "UI5開発サーバでこのFioriアプリを配信する。ポートと /odata proxy は ui5.yaml で管理する。",
    "start": "ui5 serve --open index.html",
    "build": "ui5 build --all",
    "typecheck": "tsc --noEmit",
    "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf"
  }
}
